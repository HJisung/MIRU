COMPOSE_PROJECT_NAME=stream-platform

POSTGRES_DB=stream_platform
POSTGRES_USER=stream_app
POSTGRES_PASSWORD=local-only-change-me
POSTGRES_PORT=5432

REDIS_PORT=6379

MINIO_ROOT_USER=stream_local
MINIO_ROOT_PASSWORD=local-only-change-me-too
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=stream-media

# Application runtime values
DATABASE_URL=postgresql://stream_app:local-only-change-me@localhost:5432/stream_platform
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=stream_local
S3_SECRET_KEY=local-only-change-me-too
S3_FORCE_PATH_STYLE=true

API_HOST=0.0.0.0
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Media worker binaries (defaults to PATH when omitted)
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
