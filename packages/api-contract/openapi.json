  "info": {
    "title": "Stream Platform API",
    "description": "Public and authenticated media platform operations",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "creator@example.com"
          },
          "handle": {
            "type": "string",
            "example": "creator.one"
          },
          "displayName": {
            "type": "string",
            "example": "Creator One"
          },
          "password": {
            "type": "string",
            "minLength": 10,
            "maxLength": 128,
            "writeOnly": true
          }
        },
        "required": [
          "email",
          "handle",
          "displayName",
          "password"
        ]
      },
      "AuthUserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string"
          },
          "handle": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "bio": {
            "type": "string"
          },
          "avatarUrl": {
            "type": "string",
            "nullable": true
          },
          "role": {
            "type": "string",
            "enum": [
              "MEMBER",
              "MODERATOR",
              "ADMIN"
            ]
          }
        },
        "required": [
          "id",
          "email",
          "handle",
          "displayName",
          "bio",
          "avatarUrl",
          "role"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {}
      },
      "PublicProfileDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "handle": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "bio": {
            "type": "string"
          },
          "avatarUrl": {
            "type": "string",
            "nullable": true
          },
          "postCount": {
            "type": "number"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "handle",
          "displayName",
          "bio",
          "avatarUrl",
          "postCount",
          "createdAt"
        ]
      },
      "UpdateProfileDto": {
        "type": "object",
        "properties": {}
      },
      "CreateImageUploadDto": {
        "type": "object",
        "properties": {
          "contentType": {
            "type": "string",
            "enum": [
              "image/jpeg",
              "image/png",
              "image/webp"
            ]
          },
          "byteSize": {
            "type": "number",
            "minimum": 1,
            "maximum": 20000000
          }
        },
        "required": [
          "contentType",
          "byteSize"
        ]
      },
      "UploadSessionDto": {
        "type": "object",
        "properties": {
          "assetId": {
            "type": "string",
            "format": "uuid"
          },
          "uploadUrl": {
            "type": "string"
          },
          "expiresInSeconds": {
            "type": "number"
          },
          "requiredHeaders": {
            "type": "object"
          }
        },
        "required": [
          "assetId",
          "uploadUrl",
          "expiresInSeconds",
          "requiredHeaders"
        ]
      },
      "CreateCommentDto": {
        "type": "object",
        "properties": {}
      },
      "ReportReason": {
        "type": "string",
        "enum": [
          "SPAM",
          "HARASSMENT",
          "NUDITY",
          "VIOLENCE",
          "COPYRIGHT",
          "OTHER"
        ]
      },
      "CreateReportDto": {
        "type": "object",
        "properties": {
          "reason": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ReportReason"
              }
            ]
          }
        },
        "required": [
          "reason"
        ]
      },
      "PostFormat": {
        "type": "string",
        "enum": [
          "IMAGE",
          "SHORT_VIDEO",
          "LONG_VIDEO"
        ]
      },
      "Object": {
        "type": "object",
        "properties": {}
      },
      "CreatorSummaryDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "handle": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "avatarUrl": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "id",
          "handle",
          "displayName"
        ]
      },
      "MediaSummaryDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "mimeType": {
            "type": "string"
          },
          "width": {
            "type": "number"
          },
          "height": {
            "type": "number"
          },
          "durationMs": {
            "type": "number",
            "nullable": true
          }
        },
        "required": [
          "id",
          "url",
          "mimeType",
          "width",
          "height"
        ]
      },
      "FeedItemDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "format": {
            "allOf": [
              {
                "$ref": "#/components/schemas/PostFormat"
              }
            ]
          },
          "title": {
            "type": "string",
            "nullable": true
          },
          "caption": {
            "type": "string"
          },
          "publishedAt": {
            "type": "string"
          },
          "likeCount": {
            "type": "number"
          },
          "commentCount": {
            "type": "number"
          },
          "author": {
            "$ref": "#/components/schemas/CreatorSummaryDto"
          },
          "media": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MediaSummaryDto"
            }
          }
        },
        "required": [
          "id",
          "format",
          "caption",
          "publishedAt",
          "likeCount",
          "commentCount",
          "author",
          "media"
        ]
      },
      "DiscoveryFeedDto": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FeedItemDto"
            }
          },
          "nextCursor": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "items"
        ]
      },
      "CreateImagePostDto": {
        "type": "object",
        "properties": {
          "assetId": {
            "type": "string",
            "format": "uuid"
          },
          "caption": {
            "type": "string",
            "maxLength": 2200
          }
        },
        "required": [
          "assetId",
          "caption"
        ]
      }
    }
  }
}
