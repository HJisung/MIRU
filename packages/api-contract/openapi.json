  "info": {
    "title": "Stream Platform API",
    "description": "Public and authenticated media platform operations",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "creator@example.com"
          },
          "handle": {
            "type": "string",
            "example": "creator.one"
          },
          "displayName": {
            "type": "string",
            "example": "Creator One"
          },
          "password": {
            "type": "string",
            "minLength": 10,
            "maxLength": 128,
            "writeOnly": true
          }
        },
        "required": [
          "email",
          "handle",
          "displayName",
          "password"
        ]
      },
      "AuthUserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string"
          },
          "handle": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "bio": {
            "type": "string"
          },
          "avatarUrl": {
            "type": "string",
            "nullable": true
          },
          "role": {
            "type": "string",
            "enum": [
              "MEMBER",
              "MODERATOR",
              "ADMIN"
            ]
          }
        },
        "required": [
          "id",
          "email",
          "handle",
          "displayName",
          "bio",
          "avatarUrl",
          "role"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {}
      },
      "PublicProfileDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "handle": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "bio": {
            "type": "string"
          },
          "avatarUrl": {
            "type": "string",
            "nullable": true
          },
          "postCount": {
            "type": "number"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "handle",
          "displayName",
          "bio",
          "avatarUrl",
          "postCount",
          "createdAt"
        ]
      },
      "UpdateProfileDto": {
        "type": "object",
        "properties": {}
      },
      "CreateImageUploadDto": {
        "type": "object",
