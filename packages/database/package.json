{
  "name": "@stream/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.json",
    "audit:legacy": "tsx scripts/audit-legacy-publications.ts",
    "format": "prisma format && prettier --write \"src/**/*.ts\" \"prisma/seed.ts\" \"prisma.config.ts\"",
    "generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "seed": "prisma db seed",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@types/node": "24.10.13",
    "@types/pg": "8.15.6",
    "dotenv": "17.3.1",
    "prisma": "7.9.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  }
}
